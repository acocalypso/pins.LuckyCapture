<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$([System.Runtime.InteropServices.RuntimeInformation]::RuntimeIdentifier)</RuntimeIdentifier>
    <PinsRoot Condition="'$(PinsRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\pins</PinsRoot>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <ProjectReference Include="..\..\src\PINS.LuckyCapture\PINS.LuckyCapture.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="FluentAssertions" Version="7.0.0" />
    <Compile Include="$(PinsRoot)\NINA.Test\Mediator\CameraMediatorTest.cs" Link="PinsRegression\CameraMediatorTest.cs" />
  </ItemGroup>
  <!-- PINS's compat assembly must replace the framework's System.Windows facade. -->
  <Target Name="CopyPinsWindowsCompat" AfterTargets="Build">
    <Copy SourceFiles="$(PinsRoot)\System.Windows.Compat\bin\$(Configuration)\net10.0\System.Windows.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="false" />
  </Target>
</Project>
